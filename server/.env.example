# koymukarnnovel — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ถูกเก็บใน git) ค่าว่าง = ไม่ตั้ง
# รหัสผ่าน คีย์ และโทเค็นตั้งได้ที่นี่เท่านั้น หน้าตั้งค่าในหลังบ้านไม่แสดงและไม่แก้ค่าเหล่านี้

# คีย์ Claude API (จำเป็นเมื่อจะให้ระบบแปลเอง) ไม่ตั้งก็ยังใช้วางคำแปลเอง/นำเข้าผ่านโทเค็นได้
ANTHROPIC_API_KEY=

# รหัสผ่านหลังบ้าน (/admin) จำเป็นเมื่อ HOST ไม่ใช่ 127.0.0.1 (เช่นใน Docker) ควรยาวอย่างน้อย 10 ตัวอักษร
ADMIN_PASSWORD=

# ที่อยู่และพอร์ตที่ฟัง (ค่าเริ่มต้น 127.0.0.1 และ 8787) ใน Docker Compose ตั้งให้เองเป็น 0.0.0.0 และ 8787
# HOST=127.0.0.1
# PORT=8787

# ที่อยู่เว็บจริง ใช้สร้างลิงก์สมบูรณ์ใน sitemap / OG / canonical เช่น https://koymukarnnovel.example.com (ไม่ต้องมีเครื่องหมาย / ท้าย)
PUBLIC_URL=

# จำนวนชั้น proxy ที่อยู่หน้าแอป: ไม่มี = 0, Caddy หรือ Cloudflare Tunnel ชั้นเดียว = 1, มีสองชั้น = 2
# ตั้งผิด ตัวจำกัดอัตราและยอดอ่านจะเห็น IP ของ proxy แทนผู้ใช้จริง (Docker Compose ตั้งเป็น 1 ให้เอง)
# TRUST_PROXY=0

# ที่เก็บไฟล์ฐานข้อมูล (ค่าเริ่มต้น server/data/koymukarnnovel.db) ใน Docker Compose ตั้งเป็น /data/koymukarnnovel.db
# DB_PATH=

# โมเดลเริ่มต้นสำหรับแปล และสำหรับสรุปย่อตอน/สกัดคำศัพท์ (เปลี่ยนได้ในหน้าตั้งค่าของหลังบ้านด้วย)
# TRANSLATE_MODEL=claude-sonnet-5-5
# RECAP_MODEL=claude-haiku-4-5-20251001

# ความลับเพิ่มความสุ่มให้ลายเซ็น cookie (ไม่บังคับ) สร้างค่าสุ่มด้วยคำสั่งด้านล่าง
SESSION_SECRET=

# โทเค็นของช่องทางนำเข้าคำแปลจากภายนอก (/api/import) ยาวอย่างน้อย 24 ตัวอักษร ไม่ตั้ง = ปิดช่องทางนี้
IMPORT_TOKEN=

# สร้างค่าสุ่มสำหรับ SESSION_SECRET / IMPORT_TOKEN (รันในเทอร์มินัลแล้วคัดลอกผลมาใส่ด้านบน):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
